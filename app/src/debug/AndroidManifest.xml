<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: a test hook so CI can drive real downloads over adb without UI taps.
    Release builds never contain this receiver.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.bentlybro.grabbit.debug.ENQUEUE" />
                <action android:name="com.bentlybro.grabbit.debug.UPDATE_ENGINE" />
                <action android:name="com.bentlybro.grabbit.debug.ENGINE_INFO" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
